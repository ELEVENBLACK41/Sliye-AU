// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  LOCKED
}

enum AuthProvider {
  PASSWORD
  GITHUB
  GOOGLE
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum DataScope {
  ALL
  OWN
  DEPT
  DEPT_AND_CHILD
  PARTICIPATED
  CUSTOM
}

enum PermissionEffect {
  ALLOW
  DENY
}

/// 部门在组织树中的启停状态。
enum DepartmentStatus {
  /// 部门正常启用，可以接收成员和业务数据。
  ACTIVE
  /// 部门已停用，仅保留历史关系和数据。
  DISABLED
}

/// 权限记录的来源类型，用于区分代码目录与历史、自定义数据。
enum PermissionKind {
  /// 由代码权限目录维护的系统权限。
  SYSTEM
  /// 由管理员按业务需要创建的自定义权限。
  CUSTOM
  /// V2 上线前遗留并继续保留的兼容权限。
  LEGACY
}

enum ResourceType {
  DECISION
  MEETING
  AUDIT
}

enum ParticipantRole {
  VIEWER
  EDITOR
  APPROVER
  OWNER
}

enum DecisionStatus {
  DRAFT
  DISCUSSING
  VOTING
  DECIDED
  ARCHIVED
}

enum ProposalStatus {
  OPEN
  ACCEPTED
  REJECTED
  CANCELLED
}

enum VoteOption {
  APPROVE
  REJECT
  ABSTAIN
}

enum TaskStatus {
  TODO
  DOING
  DONE
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum DecisionEventType {
  DECISION_CREATED
  DECISION_UPDATED
  STATUS_CHANGED
  PARTICIPANT_ADDED
  PARTICIPANT_REMOVED
  PROPOSAL_CREATED
  PROPOSAL_UPDATED
  VOTE_CAST
  VOTE_CLOSED
  TASK_CREATED
  TASK_UPDATED
  MEETING_STARTED
  MEETING_ENDED
  AI_SUMMARY_CREATED
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?

  avatarUrl       String?
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  deptId     Int?
  department Department? @relation(fields: [deptId], references: [id], onDelete: SetNull)

  passwordCredential  UserPasswordCredential?
  authAccounts        AuthAccount[]
  authSessions        AuthSession[]
  emailVerifyTokens   EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  authLogs            AuthAuditLog[]

  roles       UserRole[]
  permissions UserPermission[]

  /// 该用户作为操作人产生的访问控制审计日志。
  accessControlAuditLogs AccessControlAuditLog[] @relation("AccessControlAuditActor")

  requestsMade     PermissionRequest[] @relation("RequestsMade")
  requestsReviewed PermissionRequest[] @relation("RequestsReviewed")

  posts Post[]

  createdDecisions     Decision[]            @relation("DecisionCreator")
  ownedDecisions       Decision[]            @relation("DecisionOwner")
  decisionParticipants DecisionParticipant[]
  proposalsCreated     DecisionProposal[]    @relation("ProposalCreator")
  votesCast            DecisionVote[]
  assignedTasks        DecisionTask[]        @relation("TaskAssignee")
  createdTasks         DecisionTask[]        @relation("TaskCreator")
  decisionEvents       DecisionEvent[]       @relation("DecisionEventActor")
  meetingParticipants  MeetingParticipant[]

  @@index([deptId])
  @@index([status])
}

model UserPasswordCredential {
  id Int @id @default(autoincrement())

  userId            Int      @unique
  passwordHash      String
  passwordAlgo      String   @default("argon2id")
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthAccount {
  id Int @id @default(autoincrement())

  userId            Int
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id String @id @default(cuid())

  userId Int
  status AuthSessionStatus @default(ACTIVE)

  userAgent    String?
  ipAddress    String?
  lastUsedAt   DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model RefreshToken {
  id String @id @default(cuid())

  sessionId String
  tokenHash String @unique

  expiresAt         DateTime
  usedAt            DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  session         AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replacesToken   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId Int

  sentTo       String
  tokenHash    String    @unique
  attemptCount Int       @default(0)
  lastSentAt   DateTime?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentTo])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAuditLog {
  id Int @id @default(autoincrement())

  userId Int?
  event  String

  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?
  metadata  Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

model OutboxEvent {
  id String @id @default(cuid())

  topic   String
  payload Json

  status       OutboxStatus @default(PENDING)
  retryCount   Int          @default(0)
  nextRetryAt  DateTime?
  sentAt       DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([topic])
  @@index([status])
  @@index([nextRetryAt])
  @@index([createdAt])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean? @default(false)
  authorId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
}

model Role {
  id       Int     @id @default(autoincrement())
  /// 稳定的角色代码，接口和权限判断只能依赖该字段。
  code     String  @unique
  /// 面向用户展示的中文角色名称。
  name     String  @unique
  /// 角色用途说明。
  desc     String?
  /// 是否为只能通过代码目录同步的系统角色。
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users UserRole[]
  perms RolePermission[]
}

model Permission {
  id Int @id @default(autoincrement())

  /// 稳定的权限码，格式为“模块:资源:动作”或“模块:动作”。
  code   String         @unique
  /// 面向用户展示的中文权限名称。
  name   String?
  /// 权限所属业务模块。
  module String
  /// 权限对应的业务动作。
  action String
  /// 权限用途说明。
  desc   String?
  /// 权限来源类型，系统目录权限不可通过管理端修改。
  kind   PermissionKind @default(CUSTOM)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  roles           RolePermission[]
  userPermissions UserPermission[]
  requestItems    PermissionRequestItem[]

  @@unique([module, action])
  @@index([module])
}

model UserRole {
  userId Int
  roleId Int

  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  /// 角色授权记录主键，允许同一权限按不同数据范围分别授权。
  id Int @id @default(autoincrement())

  roleId Int
  permId Int

  /// 当前授权记录的数据可见范围。
  scopeType DataScope @default(ALL)
  grantedAt DateTime  @default(now())

  role Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  perm Permission @relation(fields: [permId], references: [id], onDelete: Cascade)

  @@unique([roleId, permId, scopeType])
  @@index([roleId])
  @@index([permId])
}

model PermissionRequest {
  id Int @id @default(autoincrement())

  requesterId Int
  reason      String?

  status RequestStatus @default(PENDING)

  approverId   Int?
  approvalNote String?

  expiresAt DateTime?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  requester User  @relation("RequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  approver  User? @relation("RequestsReviewed", fields: [approverId], references: [id], onDelete: SetNull)

  items       PermissionRequestItem[]
  permissions UserPermission[]

  @@index([requesterId])
  @@index([approverId])
  @@index([status])
  @@index([createdAt])
}

model PermissionRequestItem {
  id Int @id @default(autoincrement())

  requestId Int
  permId    Int

  effect    PermissionEffect
  scopeType DataScope?

  request    PermissionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  permission Permission        @relation(fields: [permId], references: [id], onDelete: Cascade)

  @@unique([requestId, permId, effect, scopeType])
  @@index([permId])
}

model UserPermission {
  id Int @id @default(autoincrement())

  userId Int
  permId Int

  effect    PermissionEffect
  /// 直接授权的数据范围；拒绝授权只能使用 ALL，由业务层校验。
  scopeType DataScope        @default(ALL)

  expiresAt       DateTime?
  sourceRequestId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission         @relation(fields: [permId], references: [id], onDelete: Cascade)
  sourceRequest PermissionRequest? @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)

  @@unique([userId, permId, effect, scopeType])
  @@index([permId])
  @@index([expiresAt])
  @@index([sourceRequestId])
}

model Department {
  id Int @id @default(autoincrement())

  /// 跨接口、导入和同步场景使用的稳定部门代码。
  code      String           @unique
  /// 面向用户展示的中文部门名称。
  name      String
  /// 部门启停状态，停用部门不能接收新成员或新决策。
  status    DepartmentStatus @default(ACTIVE)
  /// 同级部门的升序排列值。
  sortOrder Int              @default(0)
  /// 上级部门主键；空值表示组织树根节点。
  parentId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DeptTree")

  users     User[]
  decisions Decision[]

  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
}

/// 访问控制配置变更审计日志，记录操作者、目标和变更前后快照。
model AccessControlAuditLog {
  /// 审计日志主键。
  id Int @id @default(autoincrement())

  /// 操作者用户主键；访问控制变更必须能追溯到具体用户。
  actorId Int

  /// 稳定的审计动作代码。
  action     String
  /// 被操作资源类型，例如 ROLE、USER 或 DEPARTMENT。
  targetType String
  /// 被操作资源标识；兼容数字主键和字符串代码。
  targetId   String

  /// 变更前的安全快照。
  before Json?
  /// 变更后的安全快照。
  after  Json?

  /// 贯穿一次 HTTP 请求或系统任务的追踪标识。
  requestId String
  /// 操作者 IP 地址。
  ipAddress String?
  /// 操作者客户端标识。
  userAgent String?

  /// 审计日志创建时间。
  createdAt DateTime @default(now())

  actor User @relation("AccessControlAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([requestId])
  @@index([createdAt])
}

model Decision {
  id Int @id @default(autoincrement())

  title       String
  description String?
  status      DecisionStatus @default(DRAFT)

  creatorId Int
  ownerId   Int?
  deptId    Int

  decidedAt  DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  department Department @relation(fields: [deptId], references: [id], onDelete: Restrict)
  creator    User       @relation("DecisionCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  owner      User?      @relation("DecisionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  participants DecisionParticipant[]
  proposals    DecisionProposal[]
  tasks        DecisionTask[]
  events       DecisionEvent[]
  meetings     MeetingSession[]

  @@index([deptId])
  @@index([creatorId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model DecisionParticipant {
  id Int @id @default(autoincrement())

  decisionId Int
  userId     Int
  role       ParticipantRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([decisionId, userId])
  @@index([userId])
  @@index([role])
}

model ResourceParticipant {
  id Int @id @default(autoincrement())

  userId Int

  resourceType ResourceType
  resourceId   Int
  role         ParticipantRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([resourceType, resourceId])
}

model DecisionProposal {
  id Int @id @default(autoincrement())

  decisionId Int
  creatorId  Int

  title       String
  description String?
  status      ProposalStatus @default(OPEN)

  acceptedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  creator  User     @relation("ProposalCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  votes  DecisionVote[]
  events DecisionEvent[]

  @@index([decisionId])
  @@index([creatorId])
  @@index([status])
}

model DecisionVote {
  id Int @id @default(autoincrement())

  proposalId Int
  voterId    Int

  option VoteOption
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  proposal DecisionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  voter    User             @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([proposalId, voterId])
  @@index([voterId])
  @@index([option])
}

model DecisionTask {
  id Int @id @default(autoincrement())

  decisionId Int
  creatorId  Int
  assigneeId Int?

  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  creator  User     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  events DecisionEvent[]

  @@index([decisionId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
}

model MeetingSession {
  id Int @id @default(autoincrement())

  decisionId Int
  title      String
  status     MeetingStatus @default(SCHEDULED)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  participants MeetingParticipant[]
  events       DecisionEvent[]

  @@index([decisionId])
  @@index([status])
}

model MeetingParticipant {
  id Int @id @default(autoincrement())

  meetingId Int
  userId    Int

  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  meeting MeetingSession @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

model DecisionEvent {
  id Int @id @default(autoincrement())

  decisionId Int
  actorId    Int?
  meetingId  Int?
  proposalId Int?
  taskId     Int?

  type  DecisionEventType
  title String

  payload Json?
  before  Json?
  after   Json?

  occurredAt        DateTime @default(now())
  recordingOffsetMs Int?
  createdAt         DateTime @default(now())

  decision Decision          @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  actor    User?             @relation("DecisionEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  meeting  MeetingSession?   @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  proposal DecisionProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  task     DecisionTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([decisionId])
  @@index([actorId])
  @@index([meetingId])
  @@index([proposalId])
  @@index([taskId])
  @@index([type])
  @@index([occurredAt])
}
