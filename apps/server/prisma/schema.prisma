// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @default(autoincrement()) @id
  email String  @unique
  name  String?
  posts Post[]

  roles UserRole[]
  deptId Int?

  
  permissions UserPermission[]
  requestsMade     PermissionRequest[] @relation("RequestsMade")
  department Department? @relation(fields: [deptId], references: [id])
  requestsReviewed PermissionRequest[] @relation("RequestsReviewed")
  createdDecisions Decision[] @relation("DecisionCreator")
  ownedDecisions Decision[] @relation("DecisionOwner")
}

model Post {
  id        Int      @default(autoincrement()) @id
  title     String
  content   String?
  published Boolean? @default(false)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique   // admin / user / viewer
  desc      String?

  users     UserRole[]
  perms     RolePermission[]
}

model Permission {
  id        Int    @id @default(autoincrement())

  code      String @unique   // decision:create
  name      String?

  module    String           // decision / meeting / audit
  action    String           // create / delete / view

  desc      String?

  roles     RolePermission[]
  userPermissions UserPermission[]
  requestItems PermissionRequestItem[]

  createdAt DateTime @default(now())
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId Int
  permId Int

  role Role @relation(fields: [roleId], references: [id])
  perm Permission @relation(fields: [permId], references: [id])

  @@id([roleId, permId])
}


enum RequestStatus {
  PENDING   // 待审批
  APPROVED  // 已批准
  REJECTED  // 已拒绝
  REVOKED   // 已撤销
}

model PermissionRequest {
  id Int @id @default(autoincrement())

  requesterId Int
  reason String?

  status RequestStatus @default(PENDING)

  approverId Int?
  approvalNote String?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  reviewedAt DateTime?

  requester User @relation("RequestsMade", fields: [requesterId], references: [id])
  approver User? @relation("RequestsReviewed", fields: [approverId], references: [id])

  items PermissionRequestItem[]
}

model PermissionRequestItem {
  id Int @id @default(autoincrement())

  requestId Int
  permId Int

  effect PermissionEffect // 1 allow / 0 deny（如果你要细粒度审批）

  scopeType DataScope? // 可选：ALL / OWN / ...

  request PermissionRequest @relation(fields: [requestId], references: [id])
  permission Permission @relation(fields: [permId], references: [id])
}


enum DataScope {
  ALL
  OWN
  DEPT
  DEPT_AND_CHILD
  PARTICIPATED
  CUSTOM
}

enum PermissionEffect {
  ALLOW
  DENY
}

model Decision {
  id Int @id @default(autoincrement())

  title String

  creatorId Int     // 谁创建的
  ownerId   Int?    // 负责人（可选）
  deptId Int
  createdAt DateTime @default(now())
  department Department @relation(fields: [deptId], references: [id])
  creator User @relation("DecisionCreator", fields: [creatorId], references: [id])
  owner User? @relation("DecisionOwner", fields: [ownerId], references: [id])
}

enum ResourceType {
  DECISION
  MEETING
  AUDIT
}

model ResourceParticipant {
  id Int @id @default(autoincrement())

  userId Int

  resourceType ResourceType // "decision" | "meeting" | "audit"
  resourceId   Int

  role String // viewer / editor / approver

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
}

model UserPermission {
  id Int @id @default(autoincrement())

  userId Int
  permId Int

  effect PermissionEffect // 1 allow, 0 deny

  scopeType DataScope?  
  // ALL | OWN | PARTICIPATED | CUSTOM

  expiresAt DateTime?

  sourceRequestId Int?

  user User @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permId], references: [id])
}

model Department {
  id Int @id @default(autoincrement())

  name String

  parentId Int?

  parent Department? @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")

  users User[]
  decisions Decision[]
}