DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextnest?schema=public"
NODE_ENV="development"
PORT=3001
SERVER_API_PREFIX="api/v1"
WEB_ORIGINS="http://localhost:3000"

# 本地头像文件目录；生产环境应指向具备持久化能力的挂载目录。
AVATAR_UPLOAD_DIR="./uploads/avatars"

# 首次同步且不存在唯一有效旧 ADMIN 时，用该邮箱精确绑定超级管理员。
BOOTSTRAP_SUPER_ADMIN_EMAIL=""

AUTH_ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# 决策群聊 Socket 使用独立短期 Ticket，不能复用 Access Token 密钥。
CHAT_SOCKET_TICKET_SECRET="replace-with-another-32-character-secret"
CHAT_SOCKET_TICKET_TTL_SECONDS=300

# 全站通知 Socket 使用独立短期 Ticket，生产环境必须设置独立随机密钥。
NOTIFICATION_SOCKET_TICKET_SECRET="replace-with-another-32-character-secret"
NOTIFICATION_SOCKET_TICKET_TTL_SECONDS=300

AUTH_EMAIL_CODE_SECRET="replace-with-at-least-32-random-characters"
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# LiveKit 相关配置；Cloud 控制台 Webhook URL 指向公开可访问的 /api/v1/livekit/webhook。

LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

LIVEKIT_TOKEN_TTL_SECONDS=600

# Next.js Agent Runtime 调用 NestJS 内部执行接口（领取、续租、事件、工具、终态）时的共享密钥。
# 只允许服务端持有；浏览器和 BFF 转发路径都不得携带该值。生产环境必填，且至少 32 位随机字符。
AI_RUNTIME_SERVICE_TOKEN="replace-with-another-32-character-secret"

# AI 持久化集成测试使用的隔离数据库连接串；未配置时该测试套件整体跳过。
# 这些用例的清理钩子会无条件清空 AI 相关表，**必须指向独立测试库，不能填开发库**。
# 建库：pnpm --filter @nextnest/server test:db:create
# 同步表结构：在 DATABASE_URL 指向该库的前提下执行 prisma migrate deploy
AI_PERSISTENCE_TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/nextnest_test?schema=public"
