DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextnest?schema=public"
NODE_ENV="development"
PORT=3001
SERVER_API_PREFIX="api/v1"
WEB_ORIGINS="http://localhost:3000"

# 本地头像文件目录；生产环境应指向具备持久化能力的挂载目录。
AVATAR_UPLOAD_DIR="./uploads/avatars"

# 首次同步且不存在唯一有效旧 ADMIN 时，用该邮箱精确绑定超级管理员。
BOOTSTRAP_SUPER_ADMIN_EMAIL=""

AUTH_ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# 决策群聊 Socket 使用独立短期 Ticket，不能复用 Access Token 密钥。
CHAT_SOCKET_TICKET_SECRET="replace-with-another-32-character-secret"
CHAT_SOCKET_TICKET_TTL_SECONDS=300

AUTH_EMAIL_CODE_SECRET="replace-with-at-least-32-random-characters"
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# LiveKit 相关配置

LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

LIVEKIT_TOKEN_TTL_SECONDS=600