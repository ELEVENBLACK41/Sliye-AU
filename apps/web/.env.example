NEST_BASE_URL="http://localhost:3001"
NEST_API_PREFIX="api/v1"
NEXT_PUBLIC_BASE_URL=""
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"

# 本地或 CI 调用 Vercel AI Gateway 时使用；Vercel 部署可改用自动提供的 OIDC。
AI_GATEWAY_API_KEY=""

# 模型角色只允许选择代码注册表中已验证且类型匹配的模型。
AI_MODEL_STANDARD_ID="openai/gpt-5.4-nano"
AI_MODEL_DEEP_REVIEW_ID="openai/gpt-5.4"
AI_MODEL_EMBEDDING_ID="openai/text-embedding-3-small"
AI_MODEL_RERANKER_ID="cohere/rerank-v4-fast"

# 必须与 apps/server 的 AI_RUNTIME_SERVICE_TOKEN 完全一致；只在 Next.js 服务端使用，
# 不能加 NEXT_PUBLIC_ 前缀，也不能出现在任何客户端组件里。
AI_RUNTIME_SERVICE_TOKEN=""
