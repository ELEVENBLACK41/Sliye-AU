<mxfile host="app.diagrams.net" modified="2026-05-24T00:00:00.000Z" agent="Codex" version="26.0.0">
  <diagram id="auth-module" name="认证与会话模块">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="认证与会话模块 ERD" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="390" y="30" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;UQ email&lt;br&gt;status&lt;br&gt;emailVerifiedAt&lt;br&gt;lastLoginAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="145" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="credential" value="&lt;b&gt;UserPasswordCredential&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;UQ FK userId&lt;br&gt;passwordHash&lt;br&gt;passwordAlgo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="120" width="230" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="auth_account" value="&lt;b&gt;AuthAccount&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK userId&lt;br&gt;provider&lt;br&gt;providerAccountId&lt;br&gt;UQ provider + accountId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="email" value="&lt;b&gt;EmailVerificationToken&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK userId&lt;br&gt;sentTo&lt;br&gt;UQ tokenHash&lt;br&gt;attemptCount / expiresAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;AuthSession&lt;/b&gt;&lt;br&gt;PK id String/cuid&lt;br&gt;FK userId&lt;br&gt;status&lt;br&gt;expiresAt&lt;br&gt;revokedAt / revokeReason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="125" width="230" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="refresh" value="&lt;b&gt;RefreshToken&lt;/b&gt;&lt;br&gt;PK id String/cuid&lt;br&gt;FK sessionId&lt;br&gt;UQ tokenHash&lt;br&gt;UQ replacedByTokenId&lt;br&gt;usedAt / revokedAt / expiresAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="320" width="230" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="reset" value="&lt;b&gt;PasswordResetToken&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK userId&lt;br&gt;UQ tokenHash&lt;br&gt;expiresAt / usedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="510" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;AuthAuditLog&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK userId nullable&lt;br&gt;event / success / reason&lt;br&gt;ipAddress / userAgent / metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="690" width="220" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="认证流程：注册创建 User + PasswordCredential，发 EmailVerificationToken；邮箱确认后创建 AuthAccount 和 AuthSession；登录/刷新维护 AuthSession 与 RefreshToken rotation；关键动作写 AuthAuditLog。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="720" width="320" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="1 - 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;fontSize=11;" edge="1" parent="1" source="user" target="credential"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="1 - N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;fontSize=11;" edge="1" parent="1" source="user" target="auth_account"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="1 - N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;fontSize=11;" edge="1" parent="1" source="user" target="email"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="1 - N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;fontSize=11;" edge="1" parent="1" source="user" target="session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="1 - N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;fontSize=11;" edge="1" parent="1" source="session" target="refresh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="rotation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;dashed=1;fontSize=11;" edge="1" parent="1" source="refresh" target="refresh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="1 - N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;fontSize=11;" edge="1" parent="1" source="user" target="reset"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="1 - N nullable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976D2;strokeWidth=2;endArrow=classic;fontSize=11;" edge="1" parent="1" source="user" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
