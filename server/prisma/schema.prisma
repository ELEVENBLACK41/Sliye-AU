// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @default(autoincrement()) @id
  email String  @unique
  name  String?
  posts Post[]

  roles UserRole[]
  permissions UserPermission[]
  requestsMade     PermissionRequest[] @relation("RequestsMade")
  requestsReviewed PermissionRequest[] @relation("RequestsReviewed")
}

model Post {
  id        Int      @default(autoincrement()) @id
  title     String
  content   String?
  published Boolean? @default(false)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique   // admin / user / viewer
  desc      String?

  users     UserRole[]
  perms     RolePermission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  code      String   @unique   // user:create / user:delete
  desc      String?

  roles     RolePermission[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId Int
  permId Int

  role Role @relation(fields: [roleId], references: [id])
  perm Permission @relation(fields: [permId], references: [id])

  @@id([roleId, permId])
}

model UserPermission {
  id        Int    @id @default(autoincrement())
  userId    Int
  permCode  String

  effect    Int    // 1=允许 0=禁止（核心）

  expiresAt       DateTime? // null=永久，有值=临时权限
  sourceRequestId Int?      @unique

  user          User               @relation(fields: [userId], references: [id])
  sourceRequest PermissionRequest? @relation("GrantedPerm", fields: [sourceRequestId], references: [id])

  @@index([userId])
  @@index([permCode])
  @@index([expiresAt])
}

enum RequestStatus {
  PENDING   // 待审批
  APPROVED  // 已批准
  REJECTED  // 已拒绝
  REVOKED   // 已撤销
}

model PermissionRequest {
  id           Int           @id @default(autoincrement())
  requesterId  Int
  permCode     String
  reason       String?       // 申请理由

  status       RequestStatus @default(PENDING)
  approverId   Int?
  approvalNote String?       // 审批意见

  expiresAt    DateTime?     // 申请的到期时间，null=申请永久权限

  createdAt    DateTime      @default(now())
  reviewedAt   DateTime?

  requester   User            @relation("RequestsMade",     fields: [requesterId], references: [id])
  approver    User?           @relation("RequestsReviewed", fields: [approverId],  references: [id])
  grantedPerm UserPermission? @relation("GrantedPerm") // 审批通过后生成的权限记录（1对1）

  @@index([requesterId])
  @@index([status])
}